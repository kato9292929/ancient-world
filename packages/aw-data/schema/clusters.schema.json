{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ancient-world/schema/clusters.schema.json",
  "title": "clusters",
  "type": "array",
  "items": { "$ref": "#/definitions/cluster" },
  "definitions": {
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name_ja"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "スラッグ。sites.json の cluster が参照する"
        },
        "name_ja": { "type": "string", "minLength": 1 },
        "name_en": { "type": "string", "minLength": 1, "description": "台帳に記載があれば入れる。任意" },
        "note": { "type": "string" }
      }
    }
  }
}
